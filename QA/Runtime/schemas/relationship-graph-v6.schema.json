{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rubix/rashad/v6/relationship-graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engagement_id",
    "page_id",
    "nodes",
    "edges",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "6.0"
    },
    "engagement_id": {
      "type": "string",
      "minLength": 3
    },
    "page_id": {
      "type": "string",
      "pattern": "^P[0-9]{2,3}$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "label",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{0,23}$"
          },
          "type": {
            "enum": [
              "ACTOR",
              "CAPABILITY",
              "PROCESS",
              "ASSET",
              "OUTCOME",
              "CONSTRAINT",
              "MEASURE",
              "DECISION",
              "RISK",
              "EVIDENCE"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^EV-[0-9]{4,6}$"
            }
          },
          "importance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "cross_cutting": {
            "type": "boolean"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "relation",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]{1,3}$"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "ENABLES",
              "DEPENDS_ON",
              "FLOWS_TO",
              "CONTROLS",
              "MEASURES",
              "EVIDENCES",
              "RISKS",
              "PRIORITIZES",
              "OWNS",
              "APPROVES",
              "FEEDS_BACK",
              "THRESHOLD_FOR",
              "MAPS_TO",
              "BLOCKS"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^EV-[0-9]{4,6}$"
            }
          },
          "strength": {
            "enum": [
              "PRIMARY",
              "SUPPORTING"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "derived_from",
        "derived_at"
      ],
      "properties": {
        "derived_from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "derived_at": {
          "type": "string"
        },
        "r_codes_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
