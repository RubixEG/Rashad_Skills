    "scores":{"type":"object","required":["message_clarity","five_second_comprehension","visual_form_fitness","simplicity","executive_hierarchy","evidence_legibility","artifact_usefulness","specificity_to_page","rtl_typography","brand_fidelity","production_quality"]},
    "generic_layout_swap_test":{"const":"PASS"},
    "artifact_skeptic_test":{"const":"PASS"},
    "five_second_test":{"const":"PASS"}
  },
  "additionalProperties":true
}
