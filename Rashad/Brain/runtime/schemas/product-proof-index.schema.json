{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "engagement_id",
    "product",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": "6.1"
    },
    "engagement_id": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "page_id",
          "path",
          "critical",
          "master_file",
          "master_sha256"
        ],
        "properties": {
          "page_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "master_file": {
            "type": "string",
            "minLength": 1
          },
          "master_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}