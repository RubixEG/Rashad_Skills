    "pdf_parity": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_EXECUTED"
      ]
    },
    "pptx_parity": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_EXECUTED"
      ]
    },
    "deck_qa": {
