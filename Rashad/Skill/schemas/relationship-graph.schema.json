{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rubix.sa/rashad/v5.2/relationship-graph.schema.json",
  "title": "Rashad Semantic Relationship Graph",
  "description": "Closes audit finding ART-01 (BLOCKER): v5.1 defined the Semantic Relationship Graph as a 22-line word list with no schema and no consumers. This is the serialisable, validatable form that the Artifact Intelligence Engine v2 consumes.",
  "type": "object",
  "required": ["engagement_id", "page_id", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "engagement_id": {"type": "string", "minLength": 3,
      "description": "Engagement scope. Enforces isolation: a graph may not be reused across engagements."},
    "page_id": {"type": "string", "pattern": "^P[0-9]{2,3}$"},
    "schema_version": {"const": "5.2"},
    "nodes": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["id", "type", "label", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,23}$"},
          "type": {"enum": ["ACTOR","CAPABILITY","PROCESS","ASSET","OUTCOME",
                            "CONSTRAINT","MEASURE","DECISION","RISK","EVIDENCE"]},
          "label": {"type": "string", "minLength": 2, "maxLength": 120},
          "label_en": {"type": "string", "maxLength": 120},
          "evidence": {"type": "array", "minItems": 1,
            "items": {"type": "string", "pattern": "^EV-[0-9]{4,6}$"},
            "description": "AI2-R01: a node with no evidence anchor is inadmissible."},
          "confidence": {"enum": ["HIGH","MEDIUM","LOW"], "default": "HIGH"},
          "cross_cutting": {"type": "boolean", "default": false}
        }
      }
    },
    "edges": {
      "type": "array", "maxItems": 80,
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "relation", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]{1,3}$"},
          "source": {"type": "string"},
          "target": {"type": "string"},
          "relation": {"enum": ["ENABLES","DEPENDS_ON","FLOWS_TO","CONTROLS","MEASURES",
                                "EVIDENCES","RISKS","PRIORITIZES","OWNS","APPROVES",
                                "FEEDS_BACK","THRESHOLD_FOR","MAPS_TO","BLOCKS"],
            "description": "Closed vocabulary. An unlisted relation is a modelling error, not an extension point."},
          "evidence": {"type": "array", "minItems": 1,
            "items": {"type": "string", "pattern": "^EV-[0-9]{4,6}$"}},
          "label": {"type": "string", "maxLength": 60},
          "strength": {"enum": ["PRIMARY","SUPPORTING"], "default": "PRIMARY"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["derived_from", "derived_at"],
      "properties": {
        "derived_from": {"type": "array", "items": {"type": "string"}},
        "derived_at": {"type": "string"},
        "r_codes_used": {"type": "array", "items": {"type": "string", "pattern": "^R-(E?[0-9]{2,3})$"}}
      }
    }
  }
}
